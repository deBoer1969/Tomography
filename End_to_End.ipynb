    "tifffile.imwrite(\n",
    "    output_file, t1,\n",
    "    imagej=True,                                 # opens as a 3D stack in Fiji\n",
    "    resolution=(1 / dx, 1 / dx),                 # voxel size, so scale bars are right\n",
    "    metadata={'spacing': dx, 'unit': 'angstrom', 'axes': 'ZYX'},\n",
    ")\n",
    "print('saved', t1.shape, 'to', output_file)\n",
    "# np.save(output_file.replace('.tif', '.npy'), t1)   # uncomment to also keep a .npy copy\n",
    "\n",
    "losses_np = np.array(results.losses / error_norm_total)   # one value per iteration\n",
    "plt.plot(losses_np, 'o-')\n",
    "plt.xlabel('iteration')\n",
    "plt.ylabel('normalised loss')\n",
    "plt.show()"
